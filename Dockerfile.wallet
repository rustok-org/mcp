# syntax=docker/dockerfile:1
# All-in-one self-custody wallet image: Core (gRPC) + Gateway (HTTP) + MCP, with
# the MCP spoken over stdio. One `docker run -i` is the whole wallet — keys live
# in the user's mounted volume. Source stays private: the Core/Gateway binaries
# come from the published binary image, not from source.
#
# Build (local, against a locally-built core image):
#   docker build -f Dockerfile.wallet --build-arg CORE_IMAGE=rustok-core:v0.1.4 \
#     -t rustok-wallet:0.4.4 .
# The password rides a file, not the environment. Onboard:
#   podman run -it --rm -v rustok-wallet:/data \
#     --secret rustok-keyring,type=mount,mode=0400,uid=1000,gid=1000 \
#     -e RUSTOK_KEYRING_PASSWORD_FILE=/run/secrets/rustok-keyring \
#     rustok-wallet:0.4.4 create-wallet
# Run (MCP stdio): the same run without `create-wallet`, plus `-e RUSTOK_RPC_URLS_1=…`.

# Pinned to an exact core build, never a floating tag: an unpinned build from this
# Dockerfile would silently embed a different core than the one shipped under the
# same wallet version.
#
# v0.1.3 (digest 718ffccc…) carries 12-word recovery phrases and closes
# RUSTSEC-2026-0220 in ruint. Wallets created under v0.1.2 keep their 24-word
# phrases and still unlock — the keystore holds the encrypted key, not the phrase.
ARG CORE_IMAGE=ghcr.io/rustok-org/rustok-core:v0.1.4

# --- Core/Gateway binaries (private source; public binary image) ---
FROM ${CORE_IMAGE} AS core

# --- MCP Python environment (uv, locked) ---
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev

# --- Runtime ---
FROM python:3.12-slim-bookworm AS runtime

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (matches the core/mcp images: uid/gid 1000).
RUN groupadd -g 1000 rustok && useradd -u 1000 -g rustok -m rustok \
    && mkdir -p /data && chown -R rustok:rustok /data

# MCP venv.
COPY --from=builder --chown=rustok:rustok /app /app
ENV PATH="/app/.venv/bin:$PATH"

# Core + Gateway binaries from the binary image.
COPY --from=core /usr/local/bin/core-server /usr/local/bin/core-server
COPY --from=core /usr/local/bin/gateway /usr/local/bin/gateway

COPY scripts/rustok-wallet-entrypoint.sh /usr/local/bin/rustok-wallet-entrypoint
RUN chmod +x /usr/local/bin/rustok-wallet-entrypoint /usr/local/bin/core-server /usr/local/bin/gateway

LABEL org.opencontainers.image.title="rustok-wallet" \
      org.opencontainers.image.description="Rustok self-custody Ethereum agent wallet — all-in-one MCP (stdio)" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary"
# Ownership annotation for the official MCP registry (validator reads the image
# config label; value MUST equal server.json `name`).
LABEL io.modelcontextprotocol.server.name="io.github.rustok-org/rustok-wallet"

USER rustok
ENV RUSTOK_DATA_DIR=/data
VOLUME ["/data"]

# The entrypoint is PID 1, and hands that role to tini through `exec` once the
# backend is up (tini still forwards signals and reaps zombies for the whole
# container). It is deliberately not started *under* tini: a password supplied
# the compatibility way (`-e`) would then sit in tini's /proc/1/environ for the
# life of the container, where nothing inside the image could clear it.
ENTRYPOINT ["/usr/local/bin/rustok-wallet-entrypoint"]
