# syntax=docker/dockerfile:1
# All-in-one self-custody wallet image: Core (gRPC) + Gateway (HTTP) + MCP, with
# the MCP spoken over stdio. One `docker run -i` is the whole wallet — keys live
# in the user's mounted volume. Source stays private: the Core/Gateway binaries
# come from the published binary image, not from source.
#
# Build (local, against locally-built core/console images):
#   docker build -f Dockerfile.wallet \
#     --build-arg CORE_IMAGE=rustok-core:v0.4.3 \
#     --build-arg CORE_VERSION=v0.4.3 \
#     --build-arg CONSOLE_IMAGE=rustok-console:v0.3.2 \
#     --build-arg WALLET_VERSION=0.9.5 \
#     -t rustok-wallet-tui:0.9.5 .
# The password rides a file, not the environment — see docs/INSTALL.md. Onboard:
#   podman run -it --rm -v rustok-wallet-tui:/data \
#     --secret rustok-keyring,type=mount,target=/run/keyring-pass,mode=0400,uid=1000,gid=1000 \
#     -e RUSTOK_KEYRING_PASSWORD_FILE=/run/keyring-pass \
#     rustok-wallet-tui:0.8.3 create-wallet
# Run (MCP stdio): the same run without `create-wallet`, plus `-e RUSTOK_RPC_URLS_1=…`.

ARG CORE_IMAGE=ghcr.io/rustok-org/rustok-core:v0.4.5
ARG CONSOLE_IMAGE=ghcr.io/rustok-org/rustok-console:v0.3.3

# What the finished image will say about itself when the console asks. The
# console is started with `podman exec`, which takes its environment from the
# image CONFIG — not from the entrypoint's process — so these have to be `ENV`,
# settled at build time.
#
# `CORE_VERSION` is deliberately NOT written by hand: it is checked against the
# tag of `CORE_IMAGE` below, and a build whose two disagree fails. The first
# draft tried to derive it by substitution (`${CORE_IMAGE##*:}`) and that was
# measured, not assumed — buildah passes the reference through untouched, so the
# panel would have shown the whole `ghcr.io/…` string as a version number. A
# check that refuses is worth more than an expansion that silently lies.
ARG WALLET_VERSION=0.11.0
ARG CORE_VERSION=v0.4.5

# --- Core/Gateway binaries (private source; public binary image) ---
FROM ${CORE_IMAGE} AS core

# --- Console binary (public source; public binary image) ---
FROM ${CONSOLE_IMAGE} AS console

# --- MCP Python environment (uv, locked) ---
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev

# --- Runtime ---
FROM python:3.12-slim-bookworm AS runtime

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (matches the core/mcp images: uid/gid 1000).
RUN groupadd -g 1000 rustok && useradd -u 1000 -g rustok -m rustok \
    && mkdir -p /data && chown -R rustok:rustok /data

# MCP venv.
COPY --from=builder --chown=rustok:rustok /app /app
ENV PATH="/app/.venv/bin:$PATH"

# Core + Gateway binaries from the binary image.
COPY --from=core /usr/local/bin/core-server /usr/local/bin/core-server
COPY --from=core /usr/local/bin/gateway /usr/local/bin/gateway

# Console binary from the public console image.
COPY --from=console /usr/local/bin/rustok-console /usr/local/bin/rustok-console

COPY scripts/rustok-wallet-entrypoint.sh /usr/local/bin/rustok-wallet-entrypoint
RUN chmod +x /usr/local/bin/rustok-wallet-entrypoint \
    /usr/local/bin/core-server /usr/local/bin/gateway /usr/local/bin/rustok-console

# Directory for the approver UNIX socket. Pre-created here with the runtime user
# so the entrypoint can recreate it on tmpfs (podman) without needing root.
RUN mkdir -p /run/wallet && chown rustok:rustok /run/wallet

LABEL org.opencontainers.image.title="rustok-wallet-tui" \
      org.opencontainers.image.description="Rustok self-custody Ethereum agent wallet — all-in-one MCP (stdio)" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary" \
      org.opencontainers.image.source="https://github.com/rustok-org/mcp"
# Ownership annotation for the official MCP registry (validator reads the image
# config label; value MUST equal server.json `name`).
LABEL io.modelcontextprotocol.server.name="io.github.rustok-org/rustok-wallet-tui"

# The versions this image states about itself. The check runs in a shell, where
# suffix stripping actually works, and it fails the build rather than shipping a
# number nobody verified — the same discipline the publish workflow already
# applies to `WALLET_VERSION` against `pyproject.toml`.
ARG CORE_IMAGE
ARG CORE_VERSION
ARG WALLET_VERSION
RUN case "${CORE_IMAGE}" in \
      *@*) echo "CORE_IMAGE is pinned by digest and carries no tag — pass CORE_VERSION explicitly" >&2; exit 1 ;; \
    esac; \
    [ "${CORE_IMAGE##*:}" = "${CORE_VERSION}" ] || { \
      echo "CORE_VERSION=${CORE_VERSION} disagrees with the CORE_IMAGE tag ${CORE_IMAGE##*:} — the panel would state a version this image is not built from" >&2; \
      exit 1; }
ENV RUSTOK_WALLET_VERSION=${WALLET_VERSION} \
    RUSTOK_CORE_VERSION=${CORE_VERSION}

USER rustok
ENV RUSTOK_DATA_DIR=/data
VOLUME ["/data"]

# The entrypoint is PID 1, and hands that role to tini through `exec` once the
# backend is up (tini still forwards signals and reaps zombies for the whole
# container). It is deliberately not started *under* tini: a password supplied
# the compatibility way (`-e`) would then sit in tini's /proc/1/environ for the
# life of the container, where nothing inside the image could clear it.
ENTRYPOINT ["/usr/local/bin/rustok-wallet-entrypoint"]
